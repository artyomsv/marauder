# --------------------------------------------------------------------
# Marauder — environment variables
# --------------------------------------------------------------------
# Copy this file to `.env` and fill in the values before running
# `docker compose up -d`.
# --------------------------------------------------------------------

# --- CRITICAL SECRETS -----------------------------------------------
# A 32-byte AES-256 master key, base64-encoded. Generate with:
#   openssl rand -base64 32
# ***LOSING THIS KEY WILL MAKE ALL STORED CREDENTIALS UNRECOVERABLE.***
MARAUDER_MASTER_KEY=CHANGE_ME_BASE64_32_BYTES

# Bearer token required to scrape /metrics. Leave empty to disable the
# endpoint entirely. Generate with:
#   openssl rand -hex 32
MARAUDER_METRICS_TOKEN=

# --- Initial admin bootstrap ----------------------------------------
# On first start, Marauder creates this user if the users table is
# empty. After first login, change the password via the UI and then
# clear both variables to prevent accidental re-use.
MARAUDER_ADMIN_INITIAL_USERNAME=admin
MARAUDER_ADMIN_INITIAL_PASSWORD=pleasechangeme

# --- Image version (prebuilt-image stack: docker-compose.ghcr.yml) --
# Which published image tag to pull from ghcr.io/artyomsv/marauder-*.
# Pin to a release for reproducible deploys; `latest` floats with every
# release. Ignored by the build-from-source stack (docker-compose.yml).
MARAUDER_VERSION=1.14.0

# --- Database -------------------------------------------------------
POSTGRES_DB=marauder
POSTGRES_USER=marauder
POSTGRES_PASSWORD=marauder
MARAUDER_DB_URL=postgres://marauder:marauder@db:5432/marauder?sslmode=disable

# --- Server ---------------------------------------------------------
# MARAUDER_HOST_PORT is the HOST-side port the gateway publishes on.
# Must stay in the 30000-49999 range (local-port-ranges rule).
# Container-internal nginx still listens on 6688.
MARAUDER_HOST_PORT=34080
MARAUDER_HTTP_ADDR=:8679
MARAUDER_PUBLIC_BASE_URL=http://localhost:34080
MARAUDER_LOG_LEVEL=info
MARAUDER_LOG_JSON=true
MARAUDER_CORS_ORIGINS=http://localhost:34080,http://localhost:34000

# --- JWT / sessions -------------------------------------------------
MARAUDER_JWT_ISSUER=https://marauder.cc
MARAUDER_JWT_AUDIENCE=marauder-api
MARAUDER_ACCESS_TOKEN_TTL=15m
MARAUDER_REFRESH_TOKEN_TTL=720h

# --- Scheduler ------------------------------------------------------
MARAUDER_SCHEDULER_ENABLED=true
MARAUDER_SCHEDULER_TICK=1m
MARAUDER_SCHEDULER_WORKERS=8
MARAUDER_DEFAULT_CHECK_INTERVAL=15m
MARAUDER_CHECK_MAX_BACKOFF=6h
MARAUDER_TRACKER_HTTP_TIMEOUT=30s

# --- Progress watcher: detect finished downloads, emit progress updates over SSE, and fire notifications
# POLL_INTERVAL is the live-progress cadence — lower it (e.g. 2s) for snappier download bars.
MARAUDER_PROGRESS_WATCHER_ENABLED=true
MARAUDER_PROGRESS_POLL_INTERVAL=5s

# --- SSE live event stream: keepalive heartbeat interval for GET /api/v1/events
MARAUDER_SSE_HEARTBEAT_INTERVAL=25s

# --- FlareSolverr: fetch pages for Cloudflare-gated trackers (RuTracker)
# through a real browser. Required for RuTracker: its Cloudflare clearance
# cookie is bound to the TLS fingerprint of the client that earned it, so a
# cookie a browser obtains cannot be replayed by Marauder's HTTP client.
# Leave empty to disable — those trackers then fail with a "blocked by
# Cloudflare" error instead. Run one with `--profile arr` or the arr stack.
MARAUDER_FLARESOLVERR_URL=
# Ceiling on a single solve. The EFFECTIVE budget is whichever is smaller,
# this or the caller's remaining deadline — and the scheduler grants a check
# only MARAUDER_TRACKER_HTTP_TIMEOUT (+5s), so raising this alone achieves
# nothing. To genuinely allow longer solves, raise the tracker timeout too.
MARAUDER_FLARESOLVERR_TIMEOUT=60s

# --- Topic history retention: how long topic_events rows are kept before the
# background pruner deletes them. The table is append-only, so 0 (keep forever)
# means the per-topic timeline grows for the life of the install.
MARAUDER_EVENTS_RETENTION_DAYS=90
MARAUDER_EVENTS_PRUNE_INTERVAL=24h

# --- OIDC (optional) ------------------------------------------------
# Set MARAUDER_OIDC_ENABLED=true and fill the four variables below to
# allow login via Keycloak, Authentik, Auth0, or any OIDC provider.
MARAUDER_OIDC_ENABLED=false
MARAUDER_OIDC_ISSUER=https://keycloak.example.com/realms/marauder
MARAUDER_OIDC_CLIENT_ID=marauder
MARAUDER_OIDC_CLIENT_SECRET=
MARAUDER_OIDC_REDIRECT_URL=http://localhost:34080/api/v1/auth/oidc/callback
MARAUDER_OIDC_SCOPES=openid,profile,email

# --- Cloudflare solver sidecar (optional, v0.3) ---------------------
MARAUDER_CFSOLVER_ENABLED=false
MARAUDER_CFSOLVER_URL=http://cfsolver:9244
